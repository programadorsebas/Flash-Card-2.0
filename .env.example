# Obligatoria: clave privada de Anthropic. Nunca ponerla en index.html ni config.js.
ANTHROPIC_API_KEY=pega_aqui_tu_clave_privada
# Usa un ID de modelo habilitado en tu cuenta Anthropic.
CLAUDE_MODEL=claude-sonnet-4-5
PORT=3000

# Obligatorio para exigir inicio de sesión Google en las rutas /api.
# Debe ser exactamente el projectId de config.js / Firebase Console.
FIREBASE_PROJECT_ID=TU_PROYECTO

# Solo necesario si sirves frontend desde otro dominio. Para el despliegue
# recomendado (frontend servido por Express), déjalo comentado.
# ALLOWED_ORIGIN=https://tu-frontend.example.com
